# Copy this file to "key.properties" (same folder) and fill in your own
# release keystore details. Never commit the real key.properties file or
# your .jks/.keystore file — both are already covered by android/.gitignore.
#
# To generate a keystore (run once, keep the output file and passwords safe):
#   keytool -genkey -v -keystore ~/glucotrack-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias glucotrack
#
# storeFile may be an absolute path or relative to android/app/.
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=glucotrack
storeFile=/absolute/path/to/glucotrack-release.jks
